/* 医护工具页面样式 */
.tools-page {
  background: #eef6ff;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #7cc7f5 0%, #a7ddf8 100%);
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
  position: relative;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: #eef6ff;
  border-radius: 60rpx 60rpx 0 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

/* 工具容器 */
.tools-container {
  padding: 20rpx 40rpx 40rpx;
}

/* 工具卡片 */
.tool-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.tool-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 工具图标 */
.tool-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.icon-image {
  width: 56rpx;
  height: 56rpx;
}

/* 工具内容 */
.tool-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tool-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.tool-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 箭头 */
.tool-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 28rpx;
  color: #ccc;
  font-weight: bold;
}
