<view class="change-password-page">
  <view class="page-header">
    <text class="page-title">修改密码</text>
    <text class="page-subtitle">为了您的账户安全，请定期修改密码</text>
  </view>

  <view class="form-content">
    <view class="form-section">
      <view class="form-item">
        <view class="label-row">
          <text class="label">原密码</text>
          <text class="required">*</text>
        </view>
        <view class="input-row">
          <input 
            class="input" 
            type="{{showOldPassword ? 'text' : 'password'}}"
            placeholder="请输入原密码" 
            value="{{oldPassword}}" 
            bindinput="onOldPasswordInput"
            maxlength="20"
          />
          <text class="eye-icon" bindtap="toggleOldPassword">{{showOldPassword ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
      </view>

      <view class="form-item">
        <view class="label-row">
          <text class="label">新密码</text>
          <text class="required">*</text>
        </view>
        <view class="input-row">
          <input 
            class="input" 
            type="{{showNewPassword ? 'text' : 'password'}}"
            placeholder="请输入新密码(6-20位)" 
            value="{{newPassword}}" 
            bindinput="onNewPasswordInput"
            maxlength="20"
          />
          <text class="eye-icon" bindtap="toggleNewPassword">{{showNewPassword ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
        <view class="password-strength" wx:if="{{newPassword}}">
          <text class="strength-label">密码强度：</text>
          <view class="strength-bar">
            <view class="strength-item {{passwordStrength >= 1 ? 'active weak' : ''}}"></view>
            <view class="strength-item {{passwordStrength >= 2 ? 'active medium' : ''}}"></view>
            <view class="strength-item {{passwordStrength >= 3 ? 'active strong' : ''}}"></view>
          </view>
          <text class="strength-text">{{strengthText}}</text>
        </view>
      </view>

      <view class="form-item">
        <view class="label-row">
          <text class="label">确认密码</text>
          <text class="required">*</text>
        </view>
        <view class="input-row">
          <input 
            class="input" 
            type="{{showConfirmPassword ? 'text' : 'password'}}"
            placeholder="请再次输入新密码" 
            value="{{confirmPassword}}" 
            bindinput="onConfirmPasswordInput"
            maxlength="20"
          />
          <text class="eye-icon" bindtap="toggleConfirmPassword">{{showConfirmPassword ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
      </view>
    </view>

    <view class="tips-section">
      <view class="tips-title">密码要求：</view>
      <view class="tips-item">• 长度为6-20位字符</view>
      <view class="tips-item">• 建议包含字母、数字和特殊字符</view>
      <view class="tips-item">• 不要使用过于简单的密码</view>
    </view>

    <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '确认修改'}}
    </button>
  </view>
</view>
