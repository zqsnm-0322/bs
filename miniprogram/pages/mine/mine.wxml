<view class="container">
  <view class="header-bg">
    <view class="user-info">
      <view class="avatar">
        <text>{{avatarText}}</text>
      </view>
      <view class="info">
        <text class="name">{{displayName}}</text>
        <text class="dept" wx:if="{{userInfo.role === 'RESIDENT'}}">入住编号：{{userInfo.residentId || '-'}}</text>
        <text class="dept" wx:else>{{zoneText || '未分配护理区'}}</text>
        <text class="role">{{roleText}}</text>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="personalInfo">
      <view class="menu-icon">👤</view>
      <text>个人信息</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="viewAssessmentReports" wx:if="{{userInfo.role === 'RESIDENT'}}">
      <view class="menu-icon">📋</view>
      <text>我的评估报告</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="changePassword">
      <view class="menu-icon">🔒</view>
      <text>修改密码</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="aboutSystem">
      <view class="menu-icon">ℹ️</view>
      <text>关于系统</text>
      <text class="arrow">></text>
    </view>
  </view>

  <button class="btn-logout" bindtap="logout">退出登录</button>
</view>