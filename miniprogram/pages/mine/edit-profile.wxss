.edit-profile-page {
  min-height: 100vh;
  background-color: #eef6ff;
  padding-bottom: 100rpx;
}

.page-header {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  padding: 40rpx 30rpx 30rpx;
  color: white;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
}

.form-content {
  padding: 20rpx;
}

.info-section,
.form-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 只读信息项 */
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item.readonly {
  opacity: 0.7;
}

.info-item .label {
  font-size: 28rpx;
  color: #666;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
}

.form-label .required {
  color: #ff4d4f;
  margin-right: 5rpx;
  font-size: 32rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #4facfe;
  background-color: white;
}

/* 提示信息 */
.tips {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: #fff7e6;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.tips-text {
  flex: 1;
  font-size: 24rpx;
  color: #d48806;
  line-height: 1.6;
}

/* 底部按钮 */
.bottom-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background: white;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: none;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
  margin-right: 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
}

.submit-btn[disabled] {
  opacity: 0.6;
}
