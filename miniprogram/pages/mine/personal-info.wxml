<view class="personal-info-page">
  <view class="page-header">
    <text class="page-title">个人信息</text>
  </view>

  <view class="info-content">
    <view class="info-section">
      <view class="section-title">基本信息</view>
      
      <view class="info-item">
        <text class="label">姓名</text>
        <text class="value">{{userInfo.name || '-'}}</text>
      </view>

      <view class="info-item">
        <text class="label">ID号</text>
        <text class="value">{{userInfo.id || '-'}}</text>
      </view>

      <view class="info-item">
        <text class="label">入住编号</text>
        <text class="value">{{userInfo.residentNo || '-'}}</text>
      </view>

      <view class="info-item">
        <text class="label">房间床位</text>
        <text class="value">{{userInfo.roomBedNo || '未分配'}}</text>
      </view>

      <view class="info-item">
        <text class="label">性别</text>
        <text class="value">{{userInfo.gender || '-'}}</text>
      </view>

      <view class="info-item">
        <text class="label">年龄</text>
        <text class="value">{{userInfo.age ? userInfo.age + '岁' : '-'}}</text>
      </view>

      <view class="info-item">
        <text class="label">护理区</text>
        <text class="value">{{userInfo.careZone || '待分配'}}</text>
      </view>

      <view class="info-item">
        <text class="label">联系电话</text>
        <text class="value">{{userInfo.phone || '-'}}</text>
      </view>

      <view class="info-item" wx:if="{{userInfo.idCard}}">
        <text class="label">身份证号</text>
        <text class="value">{{userInfo.idCard || '-'}}</text>
      </view>

      <view class="info-item" wx:if="{{userInfo.admitTime}}">
        <text class="label">入住时间</text>
        <text class="value">{{formatDate(userInfo.admitTime)}}</text>
      </view>
    </view>

    <view class="info-section" wx:if="{{userInfo.emergencyContactName || userInfo.emergencyContactPhone}}">
      <view class="section-title">紧急联系人</view>
      
      <view class="info-item">
        <text class="label">联系人姓名</text>
        <text class="value">{{userInfo.emergencyContactName || '-'}}</text>
      </view>

      <view class="info-item">
        <text class="label">联系人电话</text>
        <text class="value">{{userInfo.emergencyContactPhone || '-'}}</text>
      </view>
    </view>

    <view class="tips">
      <text class="tips-icon">💡</text>
      <text class="tips-text">如需修改个人信息，请联系护理员或照护主管</text>
    </view>
  </view>
</view>
