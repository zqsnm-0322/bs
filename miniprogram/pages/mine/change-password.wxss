page {
  background: #eef6ff;
}

.change-password-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-header {
  background: linear-gradient(135deg, #7cc7f5 0%, #a7ddf8 100%);
  padding: 60rpx 30rpx 50rpx;
  text-align: center;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.form-content {
  padding: 30rpx;
}

.form-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.required {
  color: #f5222d;
  margin-left: 8rpx;
  font-size: 28rpx;
}

.input-row {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-row:focus-within {
  background: white;
  border-color: #7cc7f5;
  box-shadow: 0 0 0 4rpx rgba(79, 172, 254, 0.1);
}

.input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
}

.eye-icon {
  font-size: 36rpx;
  padding: 10rpx;
  cursor: pointer;
}

.password-strength {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.strength-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}

.strength-bar {
  display: flex;
  gap: 8rpx;
  flex: 1;
}

.strength-item {
  flex: 1;
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 4rpx;
  transition: all 0.3s ease;
}

.strength-item.active.weak {
  background: #f5222d;
}

.strength-item.active.medium {
  background: #faad14;
}

.strength-item.active.strong {
  background: #52c41a;
}

.strength-text {
  font-size: 24rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

.tips-section {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 30rpx 0;
}

.tips-title {
  font-size: 26rpx;
  color: #0050b3;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #096dd9;
  line-height: 2;
  padding-left: 8rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #7cc7f5 0%, #a7ddf8 100%);
  color: white;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(79, 172, 254, 0.3);
  transition: all 0.3s ease;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(79, 172, 254, 0.3);
}

.submit-btn[disabled] {
  background: #d9d9d9;
  color: #999;
  box-shadow: none;
}
