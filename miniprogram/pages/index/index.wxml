<view class="page">
  <!-- 医护人员界面 -->
  <view wx:if="{{userType !== 'RESIDENT'}}">
    <!-- 头部欢迎 -->
    <view class="header">
      <text class="welcome">你好，{{userInfo.realName || userInfo.name}}</text>
      <text class="role">{{userInfo.role === 'DIRECTOR' ? '院长' : userInfo.role === 'CARE_MANAGER' ? '照护主管' : userInfo.role === 'CAREGIVER' ? '照护员' : '护理员'}}</text>
    </view>

    <!-- 数据概览 -->
    <view class="card-container">
      <view class="card bg-blue">
        <text class="num">{{stats.onlineResident || 0}}</text>
        <text class="label">在住老人</text>
      </view>
      <view class="card bg-red">
        <text class="num">{{stats.todayHighRisk || 0}}</text>
        <text class="label">今日高危</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="section-title">常用功能</view>
    <view class="grid-nav">
      <!-- 需求10: 删除扫码评估 -->
      <view class="grid-item" bindtap="goResidentManage">
        <text class="grid-icon">👥</text>
        <text>老人管理</text>
      </view>
      <view class="grid-item" bindtap="goAlerts">
        <text class="grid-icon">🔔</text>
        <text>预警消息</text>
      </view>
      <view wx:if="{{userType === 'CARE_MANAGER' || userType === 'DIRECTOR'}}" class="grid-item" bindtap="goVisitAppointments">
        <text class="grid-icon">📅</text>
        <text>探访管理</text>
      </view>
      <view wx:if="{{userType === 'CAREGIVER'}}" class="grid-item" bindtap="goSymptomList">
        <text class="grid-icon">📝</text>
        <text>照护记录</text>
      </view>
    </view>

    <!-- 预警列表 -->
    <view class="section-title">最新预警</view>
    <view class="alert-list">
      <view class="alert-item" wx:for="{{alerts}}" wx:key="id">
        <view class="alert-header">
          <text class="p-name">{{item.residentName}}</text>
          <text class="p-type {{item.riskType}}">{{item.riskType === 'PRESSURE' ? 'PRESSURE 风险' : item.riskType === 'FALL' ? 'FALL 风险' : item.riskType + ' 风险'}}</text>
        </view>
        <view class="alert-msg">{{item.message}}</view>
        <view class="alert-time">{{item.createTime}}</view>
      </view>
    </view>

    <!-- 养老照护风险提示通知 -->
    <view wx:if="{{notifications.length > 0}}" class="section-title">
      照护风险提示通知
      <text class="notification-count" wx:if="{{unreadNotifications > 0}}">({{unreadNotifications}}条未读)</text>
    </view>
    <view wx:if="{{notifications.length > 0}}" class="notifications-list">
      <view 
        class="notification-item {{!item.isRead ? 'unread' : ''}}" 
        wx:for="{{notifications}}" 
        wx:key="id"
        bindtap="viewNotificationDetail"
        data-notification="{{item}}"
      >
        <view class="notification-header">
          <text class="notification-type">{{item.notificationType === 'HEALTH_PREDICTION' ? '照护风险提示' : '系统通知'}}</text>
          <text class="notification-time">{{item.createTime}}</text>
          <view wx:if="{{!item.isRead}}" class="unread-dot"></view>
        </view>
        <view class="notification-title">{{item.title}}</view>
        <view class="notification-content">{{item.content}}</view>
        <view class="notification-resident">老人：{{item.residentName}}</view>
      </view>
    </view>
  </view>

  <!-- 入住老人界面 -->
  <view wx:else>
    <!-- 老人头部 -->
    <view class="resident-header">
      <text class="welcome">你好，{{userInfo.name || '老人'}}</text>
      <text class="resident-info">入住编号：{{userInfo.residentNo || userInfo.residentId || '-'}}</text>
    </view>

    <!-- 当前风险状态 -->
    <view class="risk-card">
      <view class="risk-title">当前健康风险</view>
      <view class="risk-content">
        <view class="risk-circle" style="border-color: {{residentData.riskColor}}">
          <text class="risk-level" style="color: {{residentData.riskColor}}">{{residentData.riskLevelText}}</text>
        </view>
        <view class="risk-desc">
          <text class="risk-text">您当前的健康风险等级为{{residentData.riskLevelText}}</text>
        </view>
      </view>
    </view>

    <!-- 健康统计 -->
    <view class="resident-stats">
      <view class="stat-item">
        <text class="stat-num">{{residentData.healthStats.totalAssessments || 0}}</text>
        <text class="stat-label">评估次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num warning">{{residentData.healthStats.highRiskCount || 0}}</text>
        <text class="stat-label">高危次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num success">{{residentData.healthStats.interventionCount || 0}}</text>
        <text class="stat-label">干预次数</text>
      </view>
    </view>

    <!-- 老人健康服务 -->
    <view class="section-title">健康服务</view>
    <view class="resident-services">
      <view class="service-item" bindtap="goVisitService">
        <text class="service-icon">📅</text>
        <text class="service-name">探访预约</text>
        <text class="service-desc">提交家属探访申请</text>
      </view>
      <view class="service-item" bindtap="reportSymptom">
        <text class="service-icon">📝</text>
        <text class="service-name">症状上报</text>
        <text class="service-desc">报告身体状况</text>
      </view>
      <view class="service-item" bindtap="viewHealthRecord">
        <text class="service-icon">📋</text>
        <text class="service-name">健康档案</text>
        <text class="service-desc">查看您的健康记录</text>
      </view>
    </view>

    <!-- 养老照护风险提示 -->
    <view wx:if="{{residentData.hasPredictions}}" class="section-title">照护风险提示</view>
    <view wx:if="{{residentData.hasPredictions}}" class="predictions-section">
      <view class="prediction-alert">
        <text class="alert-icon">⚠️</text>
        <text class="alert-text">系统基于您的健康数据预测了可能出现的问题</text>
      </view>
      
      <view class="prediction-list">
        <view 
          wx:for="{{residentData.healthPredictions}}" 
          wx:key="index" 
          class="prediction-item {{item.severity === 'CRITICAL' ? 'critical' : 'high'}}"
        >
          <view class="prediction-header">
            <text class="prediction-title">{{item.condition}}</text>
            <text class="prediction-probability">{{item.probability}}</text>
          </view>
          <view class="prediction-timeframe">预计时间：{{item.timeframe}}</view>
          <view class="prediction-symptoms">
            <text class="symptoms-title">可能症状：</text>
            <text class="symptoms-text">{{item.symptoms[0]}}{{item.symptoms.length > 1 ? '等' : ''}}</text>
          </view>
        </view>
      </view>
      
      <view class="prediction-action">
        <button class="prediction-btn" bindtap="viewPredictionDetail">查看详细预测</button>
      </view>
    </view>
  </view>
</view>
