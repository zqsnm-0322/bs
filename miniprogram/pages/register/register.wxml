<view class="register-page">
  <!-- 头部区域 -->
  <view class="header">
    <view class="back-btn" bindtap="goToLogin">
      <text class="back-icon">←</text>
    </view>
    <view class="title-section">
      <text class="main-title">入住老人登记</text>
      <text class="sub-title">创建养老健康服务账号</text>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="form-container">
    <view class="form-item">
      <view class="input-wrapper">
        <text class="input-icon">👤</text>
        <input class="form-input" 
               placeholder="请输入真实姓名" 
               value="{{formData.realName}}"
               bindinput="onRealNameInput"
               maxlength="20" />
      </view>
    </view>

    <view class="form-item">
      <view class="input-wrapper">
        <text class="input-icon">🆔</text>
        <input class="form-input" 
               placeholder="请输入用户名（3-20位）" 
               value="{{formData.username}}"
               bindinput="onUsernameInput"
               maxlength="20" />
      </view>
    </view>

    <view class="form-item">
      <view class="input-wrapper">
        <text class="input-icon">🎂</text>
        <input class="form-input" 
               type="number"
               placeholder="请输入年龄" 
               value="{{formData.age}}"
               bindinput="onAgeInput"
               maxlength="3" />
      </view>
    </view>

    <view class="form-item">
      <view class="input-wrapper">
        <text class="input-icon">⚧</text>
        <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="picker-view">
            {{formData.gender || '请选择性别'}}
          </view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <view class="input-wrapper">
        <text class="input-icon">🔒</text>
        <input class="form-input" 
               password
               placeholder="请设置登录密码（6-20位）" 
               value="{{formData.password}}"
               bindinput="onPasswordInput"
               maxlength="20" />
      </view>
    </view>

    <view class="form-item">
      <view class="input-wrapper">
        <text class="input-icon">🔑</text>
        <input class="form-input" 
               password
               placeholder="请再次输入密码确认" 
               value="{{formData.confirmPassword}}"
               bindinput="onConfirmPasswordInput"
               maxlength="20" />
      </view>
    </view>

    <!-- 协议区域 -->
    <view class="agreement-section">
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-label">
          <checkbox class="agreement-checkbox" value="agree" checked="{{agreementChecked}}" />
          <text class="agreement-text">我已阅读并同意《用户协议》和《隐私政策》</text>
        </label>
      </checkbox-group>
    </view>

    <!-- 注册按钮 -->
    <button class="register-btn {{submitting ? 'loading' : ''}}" 
            bindtap="handleRegister"
            loading="{{submitting}}"
            disabled="{{submitting}}">
      <text class="btn-text">{{submitting ? '注册中...' : '立即注册'}}</text>
    </button>

    <!-- 提示信息 -->
    <view class="tips-section">
      <view class="tip-item">
        <text class="tip-icon">🛡️</text>
        <text class="tip-text">安全加密，保护您的隐私</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">📋</text>
        <text class="tip-text">注册后可查看健康档案</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">💊</text>
        <text class="tip-text">接收个性化健康宣教</text>
      </view>
    </view>
  </view>
</view>
