/* 床位调换页面样式 */
.bed-swap-page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
  position: relative;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 60rpx 60rpx 0 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 搜索框 */
.search-box {
  padding: 20rpx 40rpx;
}

.search-input {
  background: white;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 区域标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding: 20rpx 40rpx 10rpx;
}

/* 已选择的老人 */
.selected-resident {
  margin-bottom: 30rpx;
}

.resident-card.selected {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  margin: 0 40rpx 20rpx;
}

.resident-card.selected .resident-name,
.resident-card.selected .resident-detail {
  color: white;
}

.cancel-btn {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

/* 调换表单 */
.swap-form {
  background: white;
  margin: 0 40rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.picker-view {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-view .placeholder {
  color: #999;
}

.picker-view .arrow {
  color: #999;
  font-size: 24rpx;
}

/* 床位信息 */
.bed-info {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #e3f2fd;
  border-radius: 8rpx;
}

.bed-info-text {
  font-size: 24rpx;
  color: #1976d2;
  line-height: 1.6;
}

/* 提示信息 */
.form-tip {
  background: #e3f2fd;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #1976d2;
  line-height: 1.6;
}

/* 调换按钮 */
.swap-btn {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 25rpx rgba(79, 172, 254, 0.3);
}

.swap-btn[disabled] {
  opacity: 0.6;
}

/* 老人列表 */
.resident-list {
  margin-top: 30rpx;
}

.resident-card {
  display: flex;
  align-items: center;
  background: white;
  margin: 0 40rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.resident-card.active {
  border: 2rpx solid #4facfe;
  box-shadow: 0 4rpx 20rpx rgba(79, 172, 254, 0.2);
}

.resident-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

.resident-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.resident-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.resident-detail {
  font-size: 24rpx;
  color: #666;
}

.resident-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
