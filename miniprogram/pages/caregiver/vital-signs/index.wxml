<view class="vital-signs-page">
  <view class="form-container">
    <view class="form-section">
      <view class="section-title">选择老人</view>
      
      <picker mode="selector" range="{{residentList}}" range-key="name" value="{{selectedResidentIndex}}" bindchange="onResidentPickerChange">
        <view class="resident-selector">
          <view class="selector-content">
            <text class="selector-label">老人</text>
            <text class="selector-value" wx:if="{{selectedResident}}">
              {{selectedResident.name}} ({{selectedResident.bedNo}}床)
            </text>
            <text class="selector-placeholder" wx:else>请选择老人</text>
          </view>
          <text class="selector-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-section">
      <view class="section-title">记录时间</view>
      
      <view class="form-item">
        <view class="label">日期</view>
        <picker mode="date" value="{{formData.recordDate}}" bindchange="onDateChange">
          <view class="picker">{{formData.recordDate || '请选择日期'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <view class="label">时间</view>
        <picker mode="time" value="{{formData.recordTime}}" bindchange="onTimeChange">
          <view class="picker">{{formData.recordTime || '请选择时间'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">生命体征</view>
      
      <view class="form-item">
        <view class="label">体温 (℃)</view>
        <input class="input" type="digit" placeholder="如：36.5" value="{{formData.temperature}}" data-field="temperature" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <view class="label">收缩压 (mmHg)</view>
        <input class="input" type="number" placeholder="如：120" value="{{formData.systolicPressure}}" data-field="systolicPressure" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <view class="label">舒张压 (mmHg)</view>
        <input class="input" type="number" placeholder="如：80" value="{{formData.diastolicPressure}}" data-field="diastolicPressure" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <view class="label">心率 (次/分)</view>
        <input class="input" type="number" placeholder="如：72" value="{{formData.heartRate}}" data-field="heartRate" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <view class="label">呼吸频率 (次/分)</view>
        <input class="input" type="number" placeholder="如：18" value="{{formData.respiratoryRate}}" data-field="respiratoryRate" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <view class="label">血氧饱和度 (%)</view>
        <input class="input" type="digit" placeholder="如：98.5" value="{{formData.bloodOxygen}}" data-field="bloodOxygen" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <view class="label">体重 (kg)</view>
        <input class="input" type="digit" placeholder="如：65.0" value="{{formData.weight}}" data-field="weight" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <view class="label">血糖 (mmol/L)</view>
        <input class="input" type="digit" placeholder="如：5.6" value="{{formData.bloodGlucose}}" data-field="bloodGlucose" bindinput="onInputChange" />
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">备注</view>
      
      <view class="form-item">
        <textarea class="textarea" placeholder="请输入备注信息（选填）" value="{{formData.remark}}" data-field="remark" bindinput="onInputChange" maxlength="500" />
      </view>
    </view>

    <view class="button-group">
      <button class="btn btn-cancel" bindtap="onCancel">取消</button>
      <button class="btn btn-submit" bindtap="onSubmit">保存</button>
    </view>
  </view>
</view>
