<view class="medication-manage-page">
  <view class="form-container">
    <view class="form-section">
      <view class="section-title">选择老人</view>
      
      <picker mode="selector" range="{{residentList}}" range-key="name" value="{{selectedResidentIndex}}" bindchange="onResidentPickerChange">
        <view class="resident-selector">
          <view class="selector-content">
            <text class="selector-label">老人</text>
            <text class="selector-value" wx:if="{{selectedResident}}">
              {{selectedResident.name}} ({{selectedResident.bedNo}}床)
            </text>
            <text class="selector-placeholder" wx:else>请选择老人</text>
          </view>
          <text class="selector-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-section">
      <view class="section-title">药物信息</view>
      
      <view class="form-item">
        <view class="label">药品名称</view>
        <input class="input" placeholder="请输入药品名称" value="{{formData.medicationName}}" data-field="medicationName" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <view class="label">剂量</view>
        <input class="input" placeholder="如：100" value="{{formData.dosage}}" data-field="dosage" bindinput="onInputChange" type="digit" />
      </view>

      <view class="form-item">
        <view class="label">单位</view>
        <picker mode="selector" range="{{unitOptions}}" value="{{unitIndex}}" bindchange="onUnitChange">
          <view class="picker">{{formData.unit || '请选择单位'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <view class="label">用药频次</view>
        <picker mode="selector" range="{{frequencyOptions}}" value="{{frequencyIndex}}" bindchange="onFrequencyChange">
          <view class="picker">{{formData.frequency || '请选择用药频次'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <view class="label">给药途径</view>
        <picker mode="selector" range="{{routeOptions}}" value="{{routeIndex}}" bindchange="onRouteChange">
          <view class="picker">{{formData.route || '请选择给药途径'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <view class="label">疗程天数（选填）</view>
        <input class="input" placeholder="如：7" value="{{formData.duration}}" type="number" bindinput="onDurationInput" />
      </view>

      <view class="form-item">
        <view class="label">开始日期</view>
        <picker mode="date" value="{{formData.startDate}}" bindchange="onStartDateChange">
          <view class="picker">{{formData.startDate || '请选择开始日期'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <view class="label">结束日期（选填）</view>
        <picker mode="date" value="{{formData.endDate}}" bindchange="onEndDateChange">
          <view class="picker">{{formData.endDate || '请选择结束日期'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">用药说明</view>
      
      <view class="form-item">
        <view class="label">用药目的（选填）</view>
        <textarea class="textarea" placeholder="请输入用药目的" value="{{formData.purpose}}" data-field="purpose" bindinput="onInputChange" maxlength="500" />
      </view>

      <view class="form-item">
        <view class="label">备注（选填）</view>
        <textarea class="textarea" placeholder="请输入备注信息" value="{{formData.notes}}" data-field="notes" bindinput="onInputChange" maxlength="500" />
      </view>
    </view>

    <view class="button-group">
      <button class="btn btn-cancel" bindtap="onCancel">取消</button>
      <button class="btn btn-submit" bindtap="onSubmit">保存</button>
    </view>
  </view>
</view>
