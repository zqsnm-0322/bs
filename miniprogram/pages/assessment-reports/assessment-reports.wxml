<!-- 老人查看评估报告页面 -->
<view class="container">
  <view class="header">
    <text class="title">我的评估报告</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{reports.length === 0 && !loading}}" class="empty-state">
    <view class="empty-icon">📋</view>
    <text class="empty-text">暂无评估报告</text>
    <text class="empty-hint">照护主管发送的评估报告将在这里显示</text>
  </view>

  <!-- 报告列表 -->
  <view wx:else class="report-list">
    <view 
      wx:for="{{reports}}" 
      wx:key="id" 
      class="report-card"
      bindtap="viewDetail"
      data-report="{{item}}"
    >
      <!-- 报告头部 -->
      <view class="report-header">
        <view class="report-title">
          <text class="scale-name">{{item.scaleName}}</text>
          <view class="risk-badge risk-{{item.riskLevel}}">
            {{item.riskLevelText}}
          </view>
        </view>
        <text class="report-date">{{item.evaluateTime}}</text>
      </view>

      <!-- 报告内容 -->
      <view class="report-content">
        <view class="info-row">
          <text class="label">评估得分：</text>
          <text class="value score">{{item.totalScore}}分</text>
        </view>
        <view class="info-row">
          <text class="label">评估人：</text>
          <text class="value">{{item.evaluatorName}}</text>
        </view>
        <view wx:if="{{item.suggestion}}" class="suggestion-box">
          <view class="suggestion-title">
            <text class="icon">💡</text>
            <text>建议措施</text>
          </view>
          <text class="suggestion-text">{{item.suggestion}}</text>
        </view>
      </view>

      <!-- 查看详情按钮 -->
      <view class="report-footer">
        <text class="view-detail">查看详情 ></text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</view>
