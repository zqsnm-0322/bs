page { min-height: 100%; background: #eef6ff; color: #26342f; }
.page { min-height: 100vh; padding-bottom: 50rpx; }.hero { position: relative; overflow: hidden; padding: 46rpx 30rpx 56rpx; background: linear-gradient(145deg,#7cc7f5,#a7ddf8); }.hero-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.07); }.hero-orb.one { width: 290rpx; height: 290rpx; top: -160rpx; right: -65rpx; }.hero-orb.two { width: 170rpx; height: 170rpx; bottom: -100rpx; left: -50rpx; }.eyebrow,.hero-title,.hero-subtitle { position: relative; z-index: 1; display: block; }.eyebrow { color: rgba(255,255,255,.58); font-size: 17rpx; letter-spacing: 3rpx; }.hero-title { margin-top: 10rpx; color: #fff; font-size: 42rpx; font-weight: 700; }.hero-subtitle { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 24rpx; }
.search { position: relative; z-index: 1; display: flex; align-items: center; height: 82rpx; margin-top: 30rpx; padding: 0 22rpx; border: 1rpx solid rgba(255,255,255,.22); border-radius: 18rpx; background: rgba(255,255,255,.96); box-shadow: 0 10rpx 28rpx rgba(3,61,46,.16); }.search-symbol { margin-right: 15rpx; color: #5aafe5; font-size: 34rpx; transform: rotate(-15deg); }.search input { flex: 1; color: #26342f; font-size: 25rpx; }.placeholder { color: #a9b3af; }.clear { width: 44rpx; color: #9aa5a1; font-size: 34rpx; text-align: center; }
.categories { position: relative; z-index: 2; box-sizing: border-box; width: 100%; margin-top: -20rpx; white-space: nowrap; }.category-row { display: inline-flex; gap: 14rpx; padding: 0 24rpx 18rpx; }.category { display: inline-flex; align-items: center; padding: 16rpx 22rpx; border: 1rpx solid #e3ebe8; border-radius: 28rpx; color: #65736e; font-size: 23rpx; background: #fff; box-shadow: 0 5rpx 16rpx rgba(32,78,65,.05); }.category-mark { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-right: 9rpx; border-radius: 50%; color: #5aafe5; font-size: 18rpx; font-weight: 700; background: #e8f4fd; }.category.active { border-color: #7cc7f5; color: #fff; background: #7cc7f5; }.category.active .category-mark { color: #4d9fd2; background: #fff; }
.content { padding: 6rpx 24rpx 30rpx; }.featured { position: relative; overflow: hidden; margin-bottom: 26rpx; padding: 30rpx; border-radius: 24rpx; color: #fff; background: linear-gradient(135deg,#e9903f,#f4ad60); box-shadow: 0 10rpx 28rpx rgba(204,115,38,.18); }.featured::after { position: absolute; right: -60rpx; bottom: -80rpx; width: 220rpx; height: 220rpx; border: 32rpx solid rgba(255,255,255,.1); border-radius: 50%; content: ''; }.featured-label { display: inline-block; padding: 7rpx 14rpx; border-radius: 18rpx; color: #8f4f14; font-size: 19rpx; font-weight: 700; background: rgba(255,255,255,.78); }.featured-title,.featured-summary { position: relative; z-index: 1; display: block; }.featured-title { width: 84%; margin-top: 20rpx; font-size: 32rpx; font-weight: 700; line-height: 1.42; }.featured-summary { width: 86%; margin-top: 10rpx; color: rgba(255,255,255,.86); font-size: 22rpx; line-height: 1.55; }.featured-footer { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin-top: 25rpx; }.mini-tag { margin-right: 10rpx; padding: 6rpx 12rpx; border-radius: 14rpx; color: rgba(255,255,255,.9); font-size: 18rpx; background: rgba(130,66,10,.18); }.read-now { font-size: 22rpx; font-weight: 600; }
.list-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 8rpx 4rpx 18rpx; }.list-title,.list-subtitle { display: block; }.list-title { color: #2a3934; font-size: 30rpx; font-weight: 700; }.list-subtitle { margin-top: 5rpx; color: #9aa5a1; font-size: 20rpx; }
.article { margin-bottom: 18rpx; padding: 27rpx; border: 1rpx solid #e5ece9; border-radius: 22rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(28,70,58,.045); }.article:active { transform: scale(.99); background: #fbfdfc; }.article-top { display: flex; align-items: center; justify-content: space-between; }.category-name { padding: 6rpx 13rpx; border-radius: 15rpx; color: #4d9fd2; font-size: 19rpx; font-weight: 600; background: #e8f4fd; }.read-time { color: #a2aca8; font-size: 19rpx; }.article-title { display: block; margin-top: 17rpx; color: #293833; font-size: 29rpx; font-weight: 700; line-height: 1.45; }.article-summary { display: -webkit-box; overflow: hidden; margin-top: 10rpx; color: #78847f; font-size: 22rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.article-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #eef2f0; }.tags { flex: 1; }.tag { margin-right: 11rpx; color: #95a09c; font-size: 19rpx; }.arrow { color: #5aafe5; font-size: 35rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 90rpx 20rpx; }.empty-icon { display: flex; align-items: center; justify-content: center; width: 110rpx; height: 110rpx; border-radius: 50%; color: #5aafe5; font-size: 36rpx; font-weight: 700; background: #e8f4fd; }.empty-title { margin-top: 24rpx; color: #465650; font-size: 28rpx; font-weight: 700; }.empty-desc { margin-top: 8rpx; color: #a0aaa6; font-size: 22rpx; }.empty button { width: 190rpx; height: 68rpx; margin-top: 25rpx; border: 0; border-radius: 34rpx; color: #fff; font-size: 23rpx; line-height: 68rpx; background: #7cc7f5; }.empty button::after { border: 0; }
.detail-mask { position: fixed; inset: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(13,31,25,.48); }.detail-panel { box-sizing: border-box; width: 100%; height: 82vh; padding: 12rpx 30rpx 0; border-radius: 34rpx 34rpx 0 0; background: #fff; }.detail-handle { width: 70rpx; height: 7rpx; margin: 0 auto 22rpx; border-radius: 8rpx; background: #d7dfdc; }.detail-head { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 1rpx solid #edf1ef; }.detail-category { display: block; color: #4d9fd2; font-size: 21rpx; font-weight: 600; }.detail-title { display: block; max-width: 590rpx; margin-top: 8rpx; color: #273630; font-size: 33rpx; font-weight: 700; line-height: 1.4; }.detail-close { width: 58rpx; color: #8d9994; font-size: 45rpx; text-align: center; }.detail-scroll { box-sizing: border-box; height: calc(82vh - 170rpx); padding: 25rpx 2rpx 80rpx; }.detail-summary { display: block; padding: 20rpx; border-radius: 14rpx; color: #547069; font-size: 23rpx; line-height: 1.65; background: #eef6ff; }.detail-divider { height: 1rpx; margin: 25rpx 0; background: #edf1ef; }.detail-content { white-space: pre-wrap; color: #44534e; font-size: 26rpx; line-height: 1.9; }.detail-tips { margin-top: 35rpx; padding: 20rpx; border-radius: 14rpx; color: #9a7b51; font-size: 21rpx; line-height: 1.55; background: #fff8ec; }.loading { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; color: #697872; font-size: 23rpx; background: rgba(244,247,245,.9); }
