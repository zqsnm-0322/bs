page { min-height: 100%; background: #f3f7f5; color: #25332f; }
.page { min-height: 100vh; padding-bottom: 50rpx; }
.hero { position: relative; overflow: hidden; padding: 44rpx 30rpx 86rpx; background: linear-gradient(145deg,#167d64,#20b489); }
.hero-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.08); }.orb-one { width: 300rpx; height: 300rpx; top: -180rpx; right: -80rpx; }.orb-two { width: 180rpx; height: 180rpx; bottom: -100rpx; left: -50rpx; }
.hero-top { position: relative; z-index: 1; display: flex; align-items: flex-start; justify-content: space-between; }.hero-title,.hero-subtitle { display: block; }.hero-title { color: #fff; font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }.hero-subtitle { margin-top: 9rpx; color: rgba(255,255,255,.75); font-size: 24rpx; }.update-chip { display: flex; align-items: center; margin-top: 7rpx; padding: 9rpx 15rpx; border: 1rpx solid rgba(255,255,255,.2); border-radius: 24rpx; color: rgba(255,255,255,.84); font-size: 19rpx; background: rgba(0,50,38,.14); }.pulse { width: 10rpx; height: 10rpx; margin-right: 9rpx; border-radius: 50%; background: #bfffe8; }
.occupancy-card { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin-top: 34rpx; padding: 24rpx 28rpx; border: 1rpx solid rgba(255,255,255,.2); border-radius: 22rpx; background: rgba(255,255,255,.12); }.occupancy-label { display: block; color: rgba(255,255,255,.8); font-size: 23rpx; }.occupancy-value { display: flex; align-items: baseline; margin-top: 5rpx; color: #fff; font-size: 52rpx; font-weight: 700; }.occupancy-value .unit { margin-left: 5rpx; font-size: 25rpx; font-weight: 500; }.ring { display: flex; align-items: center; justify-content: center; width: 94rpx; height: 94rpx; border-radius: 50%; }.ring-inner { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; color: rgba(255,255,255,.85); font-size: 21rpx; background: #198c6e; }
.content { position: relative; margin-top: -56rpx; padding: 0 24rpx; }
.overview-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 16rpx; }.metric-card { position: relative; display: flex; align-items: center; min-height: 116rpx; padding: 20rpx; border: 1rpx solid #e5eeea; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(22,74,59,.07); }.metric-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; margin-right: 17rpx; border-radius: 18rpx; font-size: 24rpx; font-weight: 700; }.metric-icon.green { color: #13966f; background: #e7f8f2; }.metric-icon.blue { color: #4879d8; background: #eaf0ff; }.metric-icon.gray { color: #71817c; background: #eef2f1; }.metric-icon.amber { color: #c27e17; background: #fff3dc; }.metric-value,.metric-label { display: block; }.metric-value { color: #23312d; font-size: 36rpx; font-weight: 700; }.metric-label { margin-top: 3rpx; color: #909b97; font-size: 21rpx; }.metric-arrow { position: absolute; right: 14rpx; color: #b7c0bd; font-size: 34rpx; }
.risk-banner { display: flex; align-items: center; margin: 20rpx 0; padding: 24rpx; border: 1rpx solid #f2d3ce; border-radius: 20rpx; background: linear-gradient(90deg,#fff7f5,#fff); }.risk-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; margin-right: 17rpx; border-radius: 18rpx; color: #fff; font-size: 30rpx; font-weight: 800; background: #eb6c61; }.risk-copy { display: flex; flex: 1; flex-direction: column; }.risk-title { color: #59413d; font-size: 26rpx; font-weight: 700; }.risk-desc { margin-top: 4rpx; color: #a3766e; font-size: 20rpx; }.risk-action { color: #d75f55; font-size: 21rpx; }
.section { margin-bottom: 20rpx; padding: 28rpx; border: 1rpx solid #e5ece9; border-radius: 22rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(25,72,59,.045); }.section-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 28rpx; }.section-title,.section-subtitle { display: block; }.section-title { color: #293a34; font-size: 30rpx; font-weight: 700; }.section-subtitle { margin-top: 5rpx; color: #a0aaa6; font-size: 20rpx; }.section-total { padding: 7rpx 14rpx; border-radius: 20rpx; color: #138565; font-size: 20rpx; background: #e9f8f3; }
.distribution-list { display: flex; flex-direction: column; gap: 24rpx; }.distribution-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }.distribution-meta > view { display: flex; align-items: center; }.dot { display: inline-block; width: 13rpx; height: 13rpx; margin-right: 10rpx; border-radius: 50%; }.distribution-name { color: #4c5b56; font-size: 24rpx; }.distribution-value { color: #84918c; font-size: 21rpx; }.bar,.risk-bar { overflow: hidden; height: 14rpx; border-radius: 10rpx; background: #eef2f0; }.bar-fill { min-width: 0; height: 100%; border-radius: 10rpx; }
.level-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 10rpx; }.level-item { display: flex; flex-direction: column; align-items: center; }.level-ring { display: flex; align-items: center; justify-content: center; width: 86rpx; height: 86rpx; border: 7rpx solid; border-radius: 50%; }.level-percent { color: #34443e; font-size: 23rpx; font-weight: 700; }.level-name { margin-top: 12rpx; color: #53625d; font-size: 22rpx; }.level-count { margin-top: 3rpx; color: #a0aaa6; font-size: 19rpx; }
.risk-list { display: flex; flex-direction: column; gap: 20rpx; }.risk-row { display: grid; grid-template-columns: 110rpx 1fr 54rpx; align-items: center; gap: 14rpx; }.risk-level-name { color: #52615c; font-size: 23rpx; }.risk-number { color: #43534d; font-size: 23rpx; font-weight: 700; text-align: right; }
.empty-tip { padding: 50rpx 0; color: #9ba6a2; font-size: 23rpx; text-align: center; }.loading-mask { position: fixed; inset: 0; z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #71817c; font-size: 23rpx; background: rgba(244,247,246,.84); }.spinner { width: 54rpx; height: 54rpx; margin-bottom: 18rpx; border: 6rpx solid #d8ebe5; border-top-color: #1bb489; border-radius: 50%; animation: spin .8s linear infinite; }@keyframes spin { to { transform: rotate(360deg); } }
