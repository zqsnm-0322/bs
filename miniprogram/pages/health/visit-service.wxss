page { background: #f4f7f6; color: #1f2937; }
.page { min-height: 100vh; padding-bottom: 60rpx; }
.hero { position: relative; overflow: hidden; padding: 44rpx 36rpx 34rpx; background: linear-gradient(135deg, #19b98b, #22c99a); }
.hero-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.1); }
.orb-one { width: 260rpx; height: 260rpx; top: -150rpx; right: -50rpx; }.orb-two { width: 150rpx; height: 150rpx; bottom: -90rpx; left: -30rpx; }
.hero-content { position: relative; z-index: 1; display: flex; align-items: center; }.hero-icon { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; margin-right: 24rpx; border-radius: 24rpx; color: #18aa7f; font-size: 34rpx; font-weight: 700; background: #fff; box-shadow: 0 10rpx 24rpx rgba(8,100,75,.18); }
.hero-copy { display: flex; flex-direction: column; }.hero-title { color: #fff; font-size: 40rpx; font-weight: 700; }.hero-subtitle { margin-top: 8rpx; color: rgba(255,255,255,.82); font-size: 25rpx; }
.resident-chip { position: relative; z-index: 1; display: inline-flex; align-items: center; margin-top: 28rpx; padding: 12rpx 22rpx; border: 1rpx solid rgba(255,255,255,.26); border-radius: 30rpx; color: #fff; font-size: 23rpx; background: rgba(0,90,65,.14); }.resident-dot { width: 12rpx; height: 12rpx; margin-right: 12rpx; border-radius: 50%; background: #d8fff3; }
.tabs { display: flex; height: 96rpx; padding: 0 72rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(34,72,62,.06); }.tab { position: relative; display: flex; flex: 1; gap: 10rpx; align-items: center; justify-content: center; color: #8a9692; font-size: 28rpx; }.tab.active { color: #14aa7e; font-weight: 600; }.tab-line { position: absolute; bottom: 0; left: 28%; width: 44%; height: 6rpx; border-radius: 6rpx 6rpx 0 0; }.tab.active .tab-line { background: #18b889; }.tab-badge { min-width: 28rpx; padding: 1rpx 7rpx; border-radius: 20rpx; color: #fff; font-size: 18rpx; text-align: center; background: #ff8c5a; }
.content { padding: 24rpx; }.notice { display: flex; align-items: flex-start; margin-bottom: 22rpx; padding: 20rpx 22rpx; border: 1rpx solid #cceee4; border-radius: 16rpx; color: #527069; font-size: 23rpx; line-height: 1.55; background: #effbf7; }.notice-icon { flex: none; width: 32rpx; height: 32rpx; margin: 1rpx 14rpx 0 0; border-radius: 50%; color: #fff; font-size: 21rpx; font-weight: 700; line-height: 32rpx; text-align: center; background: #1ab689; }
.card { position: relative; margin-bottom: 22rpx; padding: 30rpx; border: 1rpx solid #e7eeeb; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(31,72,61,.05); }.card-title { display: flex; align-items: center; margin-bottom: 12rpx; }.card-title.compact { margin-bottom: 24rpx; }.title-icon { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-right: 18rpx; border-radius: 16rpx; font-size: 23rpx; font-weight: 700; }.title-icon.mint { color: #0f9e75; background: #e7f9f3; }.title-icon.blue { color: #4f79db; background: #edf2ff; }.title-icon.amber { color: #c68119; background: #fff5df; }.title-main { display: block; color: #26332f; font-size: 30rpx; font-weight: 700; }.title-sub { display: block; margin-top: 4rpx; color: #9aa5a1; font-size: 21rpx; }
.field { padding: 22rpx 0; border-bottom: 1rpx solid #edf1ef; }.field.last { padding-bottom: 8rpx; border-bottom: 0; }.field-label { display: block; margin-bottom: 14rpx; color: #52615c; font-size: 25rpx; }.required { color: #f06464; }.field-input { box-sizing: border-box; width: 100%; height: 78rpx; padding: 0 22rpx; border: 1rpx solid #dfe8e5; border-radius: 14rpx; color: #25332f; font-size: 27rpx; background: #fafcfb; }.placeholder { color: #b6bfbc; }
.relation-list { display: flex; flex-wrap: wrap; gap: 14rpx; }.relation-item { min-width: 80rpx; padding: 14rpx 22rpx; border: 1rpx solid #e0e8e5; border-radius: 12rpx; color: #73807c; font-size: 24rpx; text-align: center; background: #fafcfb; }.relation-item.selected { border-color: #1bb789; color: #119a73; font-weight: 600; background: #eaf9f4; }
.picker-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 24rpx 0; border-top: 1rpx solid #edf1ef; border-bottom: 1rpx solid #edf1ef; }.picker-label { display: block; color: #52615c; font-size: 25rpx; }.picker-value { display: flex; align-items: center; color: #172b25; font-size: 27rpx; font-weight: 600; }.chevron { margin-left: 18rpx; color: #a8b3af; font-size: 40rpx; font-weight: 300; }
.time-row { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #edf1ef; }.time-picker { flex: 1; }.time-box { display: flex; flex-direction: column; align-items: center; padding: 20rpx 12rpx; border: 1rpx solid #e0e8e5; border-radius: 14rpx; background: #fafcfb; }.time-label { color: #96a19d; font-size: 21rpx; }.time-value { margin-top: 8rpx; color: #18a77d; font-size: 31rpx; font-weight: 700; }.time-separator { margin: 0 18rpx; color: #9aa5a1; font-size: 23rpx; }
.count-row { display: flex; align-items: center; justify-content: space-between; padding-top: 24rpx; }.count-tip { display: block; margin-top: 5rpx; color: #a7b0ad; font-size: 20rpx; }.stepper { display: flex; align-items: center; overflow: hidden; border: 1rpx solid #dfe7e4; border-radius: 12rpx; }.step-btn { display: flex; align-items: center; justify-content: center; width: 66rpx !important; height: 58rpx; padding: 0; border-radius: 0; color: #5d6d67; font-size: 31rpx; line-height: 58rpx; background: #f6f9f8; }.step-btn::after { border: 0; }.step-btn.plus { color: #fff; background: #1bb789; }.step-value { width: 64rpx; color: #25332f; font-size: 27rpx; font-weight: 600; text-align: center; }
.notes { box-sizing: border-box; width: 100%; height: 180rpx; padding: 22rpx; border: 1rpx solid #dfe8e5; border-radius: 14rpx; color: #26332f; font-size: 25rpx; line-height: 1.6; background: #fafcfb; }.word-count { position: absolute; right: 46rpx; bottom: 43rpx; color: #b1bbb7; font-size: 20rpx; }
.submit-btn { height: 92rpx; margin: 10rpx 0 0; border-radius: 46rpx; color: #fff; font-size: 30rpx; font-weight: 700; line-height: 92rpx; background: linear-gradient(90deg, #14a979, #20c797); box-shadow: 0 12rpx 28rpx rgba(24,183,135,.26); }.submit-btn::after { border: 0; }.submit-btn[disabled] { color: rgba(255,255,255,.8); background: #8bd9c1; }.submit-tip { display: block; margin-top: 18rpx; color: #a0aaa6; font-size: 20rpx; text-align: center; }
.history { padding-top: 28rpx; }.loading { padding: 80rpx 0; color: #98a39f; font-size: 25rpx; text-align: center; }.visit-card { margin-bottom: 22rpx; padding: 28rpx; border-left: 6rpx solid #f2b84b; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(31,72,61,.06); }.status-border-APPROVED { border-left-color: #1bb789; }.status-border-REJECTED,.status-border-CANCELLED { border-left-color: #e77a76; }.status-border-COMPLETED { border-left-color: #7e91a8; }
.visit-head { display: flex; align-items: center; }.visitor-avatar { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 18rpx; border-radius: 50%; color: #119d76; font-size: 28rpx; font-weight: 700; background: #e8f9f3; }.visitor-info { display: flex; flex: 1; flex-direction: column; }.visitor-name { color: #26332f; font-size: 29rpx; font-weight: 700; }.visitor-relation { margin-top: 6rpx; color: #929d99; font-size: 22rpx; }.status { padding: 8rpx 15rpx; border-radius: 20rpx; color: #b27b17; font-size: 21rpx; background: #fff6df; }.status-APPROVED { color: #12825f; background: #e6f8f1; }.status-REJECTED,.status-CANCELLED { color: #c95050; background: #fff0ef; }.status-COMPLETED { color: #5f7083; background: #eef2f6; }
.visit-time { display: flex; align-items: center; margin-top: 24rpx; padding: 20rpx; border-radius: 14rpx; background: #f7faf9; }.calendar-icon { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 16rpx; border-radius: 12rpx; color: #4f79db; font-size: 21rpx; font-weight: 700; background: #eaf0ff; }.visit-date,.visit-hours { display: block; }.visit-date { color: #394842; font-size: 25rpx; font-weight: 600; }.visit-hours { margin-top: 4rpx; color: #88948f; font-size: 22rpx; }.visit-note,.reject-note { margin-top: 18rpx; color: #6e7a76; font-size: 23rpx; line-height: 1.55; }.reject-note { padding: 16rpx; border-radius: 12rpx; color: #b64f4f; background: #fff3f2; }.cancel-btn { width: 180rpx; height: 62rpx; margin: 22rpx 0 0 auto; border: 1rpx solid #efaaaa; border-radius: 31rpx; color: #d45d59; font-size: 23rpx; line-height: 60rpx; background: #fff; }.cancel-btn::after { border: 0; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 110rpx 30rpx; }.empty-icon { display: flex; align-items: center; justify-content: center; width: 120rpx; height: 120rpx; border-radius: 50%; color: #20af84; font-size: 38rpx; font-weight: 700; background: #e9f9f4; }.empty-title { margin-top: 28rpx; color: #35433e; font-size: 29rpx; font-weight: 700; }.empty-subtitle { margin-top: 10rpx; color: #9aa5a1; font-size: 23rpx; }.empty-btn { width: 220rpx; height: 72rpx; margin-top: 30rpx; border-radius: 36rpx; color: #fff; font-size: 25rpx; line-height: 72rpx; background: #1bb789; }.empty-btn::after { border: 0; }
