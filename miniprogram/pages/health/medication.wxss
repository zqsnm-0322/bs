/* 用药提醒页面样式 */
.medication-page {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 页面头部 */
.page-header {
  background: #6f42c1;
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
  position: relative;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 60rpx 60rpx 0 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

/* 标签页 */
.tab-bar {
  display: flex;
  background: white;
  margin: 0 40rpx;
  border-radius: 16rpx 16rpx 0 0;
  margin-top: -20rpx;
  position: relative;
  z-index: 1;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 20rpx;
  font-size: 28rpx;
  color: #666;
  border-bottom: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #667eea;
  border-bottom-color: #667eea;
  font-weight: bold;
}

/* 用药列表 */
.medications-tab,
.reminders-tab {
  background: white;
  margin: 0 40rpx;
  border-radius: 0 0 16rpx 16rpx;
  min-height: calc(100vh - 300rpx);
}

.medications-content,
.reminders-content {
  height: calc(100vh - 300rpx);
  padding: 40rpx;
}

/* 添加药物 */
.add-medication {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border: 2rpx dashed #667eea;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  transition: all 0.3s ease;
}

.add-medication:active {
  transform: scale(0.98);
}

.add-icon {
  font-size: 48rpx;
  color: #667eea;
  margin-right: 20rpx;
}

.add-text {
  font-size: 28rpx;
  color: #667eea;
  font-weight: bold;
}

/* 药物卡片 */
.medications-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.medication-card {
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 30rpx;
  border-left: 6rpx solid #667eea;
  transition: all 0.3s ease;
}

.medication-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.medication-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.medication-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.medication-dosage {
  font-size: 26rpx;
  color: #666;
}

.medication-status {
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(102, 126, 234, 0.1);
}

/* 进度条 */
.medication-progress {
  margin-bottom: 20rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #333;
}

.missed-text {
  font-size: 24rpx;
  color: #f5222d;
}

.progress-bar {
  height: 8rpx;
  background: #e1e8ed;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #17a2b8;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 服药时间 */
.medication-times {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.times-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 15rpx;
}

.times-list {
  display: flex;
  gap: 10rpx;
}

.time-item {
  font-size: 24rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

/* 用药日期 */
.medication-dates {
  display: flex;
  gap: 30rpx;
  margin-bottom: 15rpx;
  padding: 15rpx 20rpx;
  background: rgba(102, 126, 234, 0.05);
  border-radius: 12rpx;
}

.date-item {
  display: flex;
  align-items: center;
}

.date-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.date-value {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

/* 下次服药 */
.next-dose {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.next-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 15rpx;
}

.next-time {
  font-size: 26rpx;
  color: #52c41a;
  font-weight: bold;
}

/* 操作按钮 */
.medication-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
}

.pause-btn {
  background: #fff2e8;
  color: #fa8c16;
}

.resume-btn {
  background: #f6ffed;
  color: #52c41a;
}

/* 提醒卡片 */
.reminders-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reminder-card {
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 30rpx;
  border-left: 6rpx solid #faad14;
}

.reminder-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.reminder-time {
  display: flex;
  flex-direction: column;
}

.time-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.date-text {
  font-size: 24rpx;
  color: #666;
}

.reminder-status {
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(250, 173, 20, 0.1);
}

.reminder-medication {
  margin-bottom: 20rpx;
}

.reminder-medication .medication-name {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.reminder-medication .medication-dosage {
  font-size: 26rpx;
  color: #666;
}

/* 提醒操作 */
.reminder-actions {
  display: flex;
  gap: 15rpx;
}

.take-btn {
  background: #f6ffed;
  color: #52c41a;
}

.skip-btn {
  background: #fff1f0;
  color: #f5222d;
}

/* 服药状态信息 */
.taken-info,
.skipped-info {
  padding: 15rpx 20rpx;
  border-radius: 12rpx;
  margin-top: 15rpx;
}

.taken-info {
  background: #f6ffed;
}

.taken-text {
  font-size: 26rpx;
  color: #52c41a;
}

.skipped-info {
  background: #fff7e6;
}

.skipped-text {
  font-size: 26rpx;
  color: #fa8c16;
}

/* 空状态 */
.empty-reminders,
.empty-medications {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #ccc;
}

.medication-careManager {
  display: flex;
  align-items: center;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #e8e8e8;
}

.careManager-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.careManager-name {
  font-size: 24rpx;
  color: #666;
}

/* 药物详情弹窗 */
.medication-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.detail-content {
  background: white;
  border-radius: 20rpx;
  margin: 40rpx;
  max-height: 80vh;
  overflow: hidden;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #dc3545;
  color: white;
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
}

.close-btn {
  font-size: 48rpx;
  font-weight: bold;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.detail-body {
  padding: 40rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.detail-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  margin-bottom: 15rpx;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  width: 150rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.instructions-text,
.side-effects-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
