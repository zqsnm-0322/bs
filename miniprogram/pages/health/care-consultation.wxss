/* 在线咨询页面样式 */
.consultation-page {
  background: #eef6ff;
  min-height: 100vh;
}

/* 对话列表页面 */
.conversations-tab {
  min-height: 100vh;
}

/* 页面头部 */
.page-header {
  background: #7cc7f5;
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
  position: relative;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 60rpx 60rpx 0 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

.conversations-content {
  padding: 20rpx 40rpx 40rpx;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.action-text {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 对话列表 */
.conversations-list {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.conversation-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
  position: relative;
}

.conversation-item:last-child {
  border-bottom: none;
}

.conversation-item:active {
  background: #f8f9fa;
}

.conversation-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #6c757d;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 30rpx;
}

.conversation-info {
  flex: 1;
}

.conversation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.careManager-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.last-time {
  font-size: 24rpx;
  color: #999;
}

.careManager-title {
  display: block;
  font-size: 26rpx;
  color: #7cc7f5;
  margin-bottom: 8rpx;
}

.last-message {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unread-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #f5222d;
  color: white;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
}

/* 空状态 */
.empty-conversations {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.start-btn {
  background: #28a745;
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

/* 聊天界面 */
.chat-tab {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 聊天头部 */
.chat-header {
  display: flex;
  align-items: center;
  background: #343a40;
  padding: 40rpx;
  color: white;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  margin-right: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.chat-info {
  flex: 1;
}

.chat-careManager-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.chat-careManager-title {
  font-size: 26rpx;
  opacity: 0.8;
}

.chat-actions {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  font-size: 28rpx;
}

/* 消息容器 */
.messages-container {
  flex: 1;
  background: white;
  padding: 20rpx;
}

.messages-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message-item {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.message-item.sent {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #007bff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.message-avatar.sent {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
}

.message-content {
  max-width: 70%;
}

.message-bubble {
  background: #f0f0f0;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 8rpx;
  position: relative;
}

.sent .message-bubble {
  background: #007bff;
  color: white;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.5;
  word-wrap: break-word;
}

.message-time {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.sent .message-time {
  text-align: right;
}

/* 快捷回复 */
.quick-replies {
  background: white;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.replies-scroll {
  white-space: nowrap;
}

.replies-list {
  display: flex;
  gap: 15rpx;
  padding: 0 40rpx;
}

.reply-item {
  background: #f8f9fa;
  border: 1rpx solid #e1e8ed;
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.reply-item:active {
  background: #7cc7f5;
  color: white;
  border-color: #7cc7f5;
}

/* 输入区域 */
.input-section {
  background: white;
  padding: 20rpx 40rpx 40rpx;
  border-top: 1rpx solid #f0f0f0;
}

.input-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #f8f9fa;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  border: 2rpx solid #e1e8ed;
}

.message-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  border: none;
}

.send-btn {
  background: #7cc7f5;
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.send-btn[disabled] {
  opacity: 0.5;
  background: #ccc;
}

.send-btn.sending {
  opacity: 0.8;
}
