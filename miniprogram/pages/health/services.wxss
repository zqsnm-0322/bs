/* 健康服务页面样式 */
.services-page {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 页面头部 */
.page-header {
  background: #20c997;
  padding: 60rpx 40rpx 80rpx;
  position: relative;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 60rpx 60rpx 0 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

/* 服务容器 */
.services-container {
  padding: 20rpx 40rpx 40rpx;
}

.services-grid {
  margin-bottom: 60rpx;
}

.service-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.service-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.service-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  font-size: 40rpx;
}

.service-info {
  flex: 1;
}

.service-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.service-arrow {
  color: #ccc;
  font-size: 32rpx;
  font-weight: bold;
}

/* 老人快捷信息 */
.quick-info {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.info-cards {
  display: flex;
  gap: 20rpx;
}

.info-card {
  flex: 1;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  border: 1rpx solid rgba(102, 126, 234, 0.1);
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 医护快捷统计 */
.quick-stats {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.stats-cards {
  display: flex;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  border: 1rpx solid rgba(102, 126, 234, 0.1);
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.stat-number.warning {
  color: #faad14;
}

.stat-number.success {
  color: #52c41a;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}
