.risk-report-page {
  min-height: 100vh;
  background: #eef6ff;
  padding: 20rpx;
}

.page-header {
  text-align: center;
  padding: 40rpx 0;
  color: #ffffff;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

.loading-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.empty-tip {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #ffffff;
  opacity: 0.8;
}

.report-content {
  padding-bottom: 40rpx;
}

/* 风险等级卡片 */
.risk-level-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border-left: 8rpx solid #52c41a;
}

.risk-level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.risk-level-label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.risk-level-badge {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

.risk-level-time {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #999999;
}

.time-icon {
  font-size: 28rpx;
}

/* 健康状态卡片 */
.health-status-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.header-icon {
  font-size: 36rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.health-status-content {
  padding: 24rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
  border-left: 4rpx solid #1989fa;
}

.status-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* 健康建议卡片 */
.health-advice-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.advice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.advice-icon {
  flex-shrink: 0;
  margin-top: 4rpx;
  color: #07c160;
  font-size: 32rpx;
  font-weight: bold;
}

.advice-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

/* 温馨提示卡片 */
.tips-card {
  background: #fff7e6;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #ffd591;
}

.tips-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.tips-icon {
  font-size: 36rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #d46b08;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #ad6800;
  line-height: 1.5;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 0;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  border: none;
}

.btn-icon {
  font-size: 36rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #7cc7f5 0%, #a7ddf8 100%);
  color: #ffffff;
}

.default-btn {
  background: #ffffff;
  color: #333333;
  border: 2rpx solid #e0e0e0;
}
