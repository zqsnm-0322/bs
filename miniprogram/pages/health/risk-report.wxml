<view class="risk-report-page">
  <view class="page-header">
    <text class="header-title">我的健康评估</text>
    <text class="header-subtitle">了解您的健康状况</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 无数据状态 -->
  <view wx:elif="{{!hasReport}}" class="empty-container">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无健康评估报告</text>
    <text class="empty-tip">医护人员评估后会分享给您</text>
  </view>

  <!-- 报告内容 -->
  <view wx:else class="report-content">
    <!-- 风险等级卡片 -->
    <view class="risk-level-card" style="border-left-color: {{report.riskLevelColor}}">
      <view class="risk-level-header">
        <text class="risk-level-label">健康风险等级</text>
        <view class="risk-level-badge" style="background-color: {{report.riskLevelColor}}">
          {{report.riskLevelText}}
        </view>
      </view>
      <view class="risk-level-time">
        <text class="time-icon">🕐</text>
        <text>评估时间：{{formatDate(report.assessmentTime)}}</text>
      </view>
    </view>

    <!-- 健康状态描述 -->
    <view class="health-status-card">
      <view class="card-header">
        <text class="header-icon">ℹ️</text>
        <text class="card-title">健康状态</text>
      </view>
      <view class="health-status-content">
        <text class="status-text">{{report.healthStatus}}</text>
      </view>
    </view>

    <!-- 健康建议 -->
    <view class="health-advice-card">
      <view class="card-header">
        <text class="header-icon">💡</text>
        <text class="card-title">健康建议</text>
      </view>
      <view class="advice-list">
        <view class="advice-item" wx:for="{{report.healthAdvice}}" wx:key="index">
          <text class="advice-icon">✓</text>
          <text class="advice-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="tips-card">
      <view class="tips-header">
        <text class="tips-icon">⚠️</text>
        <text class="tips-title">温馨提示</text>
      </view>
      <view class="tips-content">
        <text class="tips-text">• 本报告仅供参考，具体诊疗请遵医嘱</text>
        <text class="tips-text">• 如有身体不适，请及时就医</text>
        <text class="tips-text">• 保持良好心态，积极配合治疗</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="action-btn primary-btn" bindtap="contactCareManager">
        <text class="btn-icon">💬</text>
        <text>联系照护主管</text>
      </button>
      <button class="action-btn default-btn" bindtap="viewHistory">
        <text class="btn-icon">📝</text>
        <text>查看历史记录</text>
      </button>
    </view>
  </view>
</view>
