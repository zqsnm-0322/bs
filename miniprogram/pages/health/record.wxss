/* 健康档案页面样式 */
page {
  background: #eef6ff;
}

.record-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 60rpx;
}

.resident-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 30rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.resident-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.resident-info {
  flex: 1;
}

.resident-name {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
}

.resident-meta {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

.export-btn {
  background: rgba(255, 255, 255, 0.25);
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 20rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.export-btn::after {
  border: none;
}

/* 标签页 */
.tab-bar {
  display: flex;
  background: white;
  margin: -30rpx 30rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 10rpx;
  font-size: 26rpx;
  color: #666;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #667eea;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 2rpx;
}

/* 内容区域 */
.content-area {
  height: calc(100vh - 340rpx);
  margin: 20rpx 30rpx 0;
}

.tab-content {
  padding: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

/* 基本信息样式 */
.info-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.info-item {
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 4rpx solid #667eea;
  transition: all 0.3s ease;
}

.info-item:active {
  transform: scale(0.98);
}

.info-item.full-width {
  grid-column: 1 / -1;
}

.info-item .label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.info-item .value {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  word-break: break-all;
}

/* 风险评估样式 */
.risk-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.risk-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.risk-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border-left: 6rpx solid #667eea;
  transition: all 0.3s ease;
}

.risk-item:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.risk-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.risk-info {
  flex: 1;
}

.risk-type {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.risk-date {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.risk-level {
  font-size: 24rpx;
  font-weight: bold;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.risk-details {
  display: flex;
  gap: 40rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.risk-score, .risk-evaluator {
  font-size: 26rpx;
  color: #666;
}

.risk-interventions {
  background: linear-gradient(135deg, #f0f4ff 0%, #e8f0ff 100%);
  border-radius: 12rpx;
  padding: 20rpx;
}

.interventions-title {
  display: block;
  font-size: 26rpx;
  color: #667eea;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.interventions-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 生命体征样式 */
.vital-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.vital-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.vital-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border-left: 6rpx solid #52c41a;
}

.vital-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.vital-data {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.vital-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 12rpx;
}

.vital-label {
  font-size: 24rpx;
  color: #999;
}

.vital-value {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.vital-remark {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.remark-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.remark-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.vital-recorder {
  margin-top: 12rpx;
  text-align: right;
}

.recorder-text {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  background: white;
  border-radius: 20rpx;
  padding: 80rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.empty-tip {
  display: block;
  font-size: 24rpx;
  color: #ccc;
}

/* 用药记录样式 */
.medication-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.medication-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.medication-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border-left: 6rpx solid #fa8c16;
}

.medication-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.medication-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.medication-status {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.medication-status.active {
  background: linear-gradient(135deg, #f6ffed 0%, #d9f7be 100%);
  color: #52c41a;
}

.medication-status.inactive {
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  color: #fa8c16;
}

.medication-details {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.medication-dosage,
.medication-frequency,
.medication-start,
.medication-end {
  font-size: 26rpx;
  color: #666;
  padding-left: 24rpx;
  position: relative;
}

.medication-dosage::before,
.medication-frequency::before,
.medication-start::before,
.medication-end::before {
  content: '•';
  position: absolute;
  left: 8rpx;
  color: #fa8c16;
  font-weight: bold;
}

/* 用药操作按钮 */
.medication-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
}

.action-btn::after {
  border: none;
}

.edit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.stop-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  color: white;
}

.resume-btn {
  background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
  color: white;
}

.action-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 添加用药按钮 */
.add-medication-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.add-medication-btn::after {
  border: none;
}

.add-medication-btn.primary {
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 健康预测样式 */
.prediction-section {
  padding: 20rpx;
}

.prediction-info {
  background: #e6f7ff;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.prediction-info .info-text {
  display: block;
  font-size: 28rpx;
  color: #0050b3;
  margin-bottom: 10rpx;
}

.prediction-info .assessment-time {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.prediction-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.prediction-item {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid #52c41a;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.prediction-item.low {
  border-left-color: #52c41a;
}

.prediction-item.medium {
  border-left-color: #faad14;
}

.prediction-item.high {
  border-left-color: #fa8c16;
}

.prediction-item.critical {
  border-left-color: #f5222d;
}

.prediction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.condition-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
}

.severity-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
}

.severity-badge.low {
  background: #52c41a;
}

.severity-badge.medium {
  background: #faad14;
}

.severity-badge.high {
  background: #fa8c16;
}

.severity-badge.critical {
  background: #f5222d;
}

.prediction-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #8c8c8c;
}

.prediction-symptoms,
.prediction-interventions {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.symptoms-label,
.interventions-label {
  color: #595959;
  font-weight: 500;
}

.symptoms-text,
.interventions-text {
  color: #262626;
}

.loading-state {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
