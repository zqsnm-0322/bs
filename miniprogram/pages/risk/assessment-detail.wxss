.assessment-detail-page {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.detail-content {
  padding-bottom: 40rpx;
}

/* 信息卡片 */
.info-card, .result-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 信息行 */
.info-row {
  display: flex;
  padding: 16rpx 0;
  align-items: center;
}

.info-row .label {
  font-size: 28rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.info-row .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 评估结果 */
.result-content {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 0;
}

.score-display {
  text-align: center;
}

.score-number {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  color: #007bff;
  line-height: 1;
  margin-bottom: 12rpx;
}

.score-label {
  font-size: 26rpx;
  color: #666;
}

.risk-badge {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.risk-badge.high {
  background: #dc3545;
  color: white;
}

.risk-badge.medium {
  background: #ffc107;
  color: white;
}

.risk-badge.low {
  background: #28a745;
  color: white;
}

/* 干预措施列表 */
.interventions-list {
  padding: 10rpx 0;
}

.intervention-item {
  display: flex;
  padding: 12rpx 0;
  align-items: flex-start;
}

.intervention-icon {
  font-size: 32rpx;
  color: #007bff;
  margin-right: 12rpx;
  line-height: 1.6;
}

.intervention-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 评估详情列表 */
.answers-list {
  padding: 10rpx 0;
}

.answer-item {
  display: flex;
  padding: 12rpx 0;
  align-items: flex-start;
}

.answer-label {
  font-size: 28rpx;
  color: #666;
  min-width: 200rpx;
  flex-shrink: 0;
}

.answer-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}
