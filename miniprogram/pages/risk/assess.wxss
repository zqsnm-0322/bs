.container {
  padding-bottom: 120rpx;
}
.section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.title {
  font-weight: bold;
  margin-bottom: 20rpx;
}
.radio-group label {
  margin-right: 30rpx;
}
.q-item {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}
.q-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.option-item {
  padding: 10rpx 0;
}
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.score {
  font-size: 40rpx;
  color: #F56C6C;
  font-weight: bold;
}
.btn-submit {
  background: #7cc7f5;
  color: #fff;
  font-size: 28rpx;
  margin: 0;
}
