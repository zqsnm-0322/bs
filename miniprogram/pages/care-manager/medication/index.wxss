.medication-manage-page {
  min-height: 100vh;
  background-color: #eef6ff;
  padding-bottom: 100rpx;
}

.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 30rpx;
  color: white;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
}

.form-container {
  padding: 20rpx;
}

.form-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
  display: flex;
  align-items: center;
}

.required {
  color: #ff4d4f;
  margin-right: 5rpx;
  font-size: 32rpx;
}

/* 老人选择器 */
.resident-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  border: 2rpx solid #e8e8e8;
}

.selector-content {
  flex: 1;
}

.selector-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 5rpx;
}

.selector-value {
  display: flex;
  flex-direction: column;
}

.resident-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.resident-info {
  font-size: 24rpx;
  color: #666;
  margin-top: 5rpx;
}

.selector-placeholder {
  font-size: 28rpx;
  color: #999;
}

.selector-arrow {
  font-size: 40rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
}

.input,
.picker {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.input:focus {
  border-color: #667eea;
  background-color: white;
}

.input-group {
  display: flex;
  gap: 10rpx;
}

.flex-1 {
  flex: 1;
}

.unit-picker {
  width: 120rpx;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  border: 2rpx solid #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

/* 提示信息 */
.tips {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: #fff7e6;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.tips-text {
  flex: 1;
  font-size: 24rpx;
  color: #d48806;
  line-height: 1.6;
}

/* 按钮组 */
.button-group {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-submit {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}
