.container {
  background: #eef6ff;
  min-height: 100vh;
}

/* 老人用户界面样式 */
.resident-view {
  padding: 40rpx;
}

.tip-card {
  background: #ffc107;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: flex-start;
  color: white;
}

.tip-icon {
  font-size: 48rpx;
  margin-right: 30rpx;
  margin-top: 10rpx;
}

.tip-content {
  flex: 1;
}

.tip-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.tip-desc {
  font-size: 28rpx;
  line-height: 1.6;
  opacity: 0.9;
}

.resident-actions {
  display: flex;
  gap: 20rpx;
}

.action-card {
  flex: 1;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.action-card:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.action-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.action-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.action-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 医护人员界面样式 */
.search-bar {
  padding: 40rpx 40rpx 20rpx;
  background: #eef6ff;
}

.search-input {
  background: white;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.list-content {
  height: calc(100vh - 200rpx);
  padding: 0 40rpx 40rpx;
}

.resident-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.resident-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.p-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e83e8c;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 30rpx;
}

.p-info {
  flex: 1;
}

.p-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.bed {
  font-size: 24rpx;
  color: #7cc7f5;
  background: #e8f4fd;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.p-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.btn-action {
  background: #28a745;
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
  background: #fff;
  color: #7cc7f5;
  border: 1rpx solid #7cc7f5;
  border-radius: 30rpx;
}
.empty {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}
