/* 新建护理计划页面样式 */
.create-plan-page {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

/* 表单内容 */
.form-content {
  height: calc(100vh - 140rpx);
  padding: 40rpx;
}

/* 表单区块 */
.form-section {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
  position: relative;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.input,
.picker {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input:focus {
  background: white;
  border-color: #17a2b8;
}

.picker {
  display: flex;
  align-items: center;
  color: #666;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.textarea:focus {
  background: white;
  border-color: #17a2b8;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 添加任务按钮 */
.add-task-btn {
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, rgba(23, 162, 184, 0.1) 0%, rgba(19, 132, 150, 0.1) 100%);
  border: 2rpx solid #17a2b8;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #17a2b8;
  line-height: 1;
}

/* 任务列表 */
.tasks-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid #17a2b8;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.task-number {
  font-size: 26rpx;
  font-weight: bold;
  color: #17a2b8;
}

.remove-task {
  font-size: 24rpx;
  color: #dc3545;
  padding: 8rpx 16rpx;
  background: rgba(220, 53, 69, 0.1);
  border-radius: 12rpx;
}

.task-input-group {
  display: flex;
  gap: 15rpx;
  align-items: center;
}

.task-input {
  flex: 1;
  height: 70rpx;
  background: white;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  border: 1rpx solid #e0e0e0;
}

.time-picker {
  width: 150rpx;
  height: 70rpx;
  background: white;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #17a2b8;
  font-weight: bold;
  border: 1rpx solid #e0e0e0;
}

/* 空状态 */
.empty-tasks {
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 操作按钮 */
.form-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx 40rpx;
  position: sticky;
  bottom: 0;
  background: #f5f5f5;
  padding-top: 20rpx;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.cancel-btn {
  background: #f0f0f0;
  color: #666;
}

.submit-btn {
  background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
  color: white;
}

.cancel-btn:active {
  opacity: 0.8;
}

.submit-btn:active {
  opacity: 0.9;
}

/* 老人信息展示 */
.resident-info {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #e8f4ff;
  border-radius: 12rpx;
  border-left: 6rpx solid #17a2b8;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  min-width: 100rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-text {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  color: #17a2b8;
  font-size: 28rpx;
  font-weight: 500;
}
