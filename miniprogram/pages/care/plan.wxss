/* 护理计划页面样式 */
.care-plan-page {
  background: #eef6ff;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* 页面头部 */
.page-header {
  background: #7cc7f5;
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
  position: relative;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: #eef6ff;
  border-radius: 60rpx 60rpx 0 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.page-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

/* 统计卡片 */
.stats-section {
  padding: 20rpx 40rpx 40rpx;
}

.stats-grid {
  display: flex;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #6c757d;
}

.stat-card.active {
  border-left-color: #007bff;
}

.stat-card.completed {
  border-left-color: #28a745;
}

.stat-card.overdue {
  border-left-color: #dc3545;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-card.active .stat-number {
  color: #007bff;
}

.stat-card.completed .stat-number {
  color: #28a745;
}

.stat-card.overdue .stat-number {
  color: #dc3545;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 筛选标签 */
.filter-section {
  padding: 0 40rpx 20rpx;
}

.filter-tabs {
  display: flex;
  white-space: nowrap;
}

.filter-tab {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  background: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: #7cc7f5;
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(23, 162, 184, 0.3);
}

/* 护理计划列表 */
.plan-list {
  padding: 0 40rpx;
}

.plan-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #007bff;
  transition: all 0.3s ease;
}

.plan-item.completed {
  border-left-color: #28a745;
  opacity: 0.8;
}

.plan-item.overdue {
  border-left-color: #dc3545;
}

.plan-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 计划头部 */
.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.resident-info {
  flex: 1;
}

.resident-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.bed-info {
  font-size: 26rpx;
  color: #666;
}

.plan-priority {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 计划标题 */
.plan-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.plan-title text:first-child {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.plan-type {
  padding: 8rpx 16rpx;
  background: rgba(23, 162, 184, 0.1);
  color: #7cc7f5;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 进度条 */
.progress-section {
  margin-bottom: 20rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 26rpx;
  color: #666;
}

.progress-percent {
  font-size: 26rpx;
  font-weight: bold;
  color: #7cc7f5;
}

.progress-bar {
  height: 8rpx;
  background: #e9ecef;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #7cc7f5;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 任务概览 */
.task-overview {
  margin-bottom: 20rpx;
}

.task-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.completed-tasks {
  font-size: 26rpx;
  color: #666;
}

.assigned-caregiver {
  font-size: 26rpx;
  color: #7cc7f5;
  font-weight: bold;
}

/* 计划底部 */
.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.plan-date {
  font-size: 24rpx;
  color: #999;
}

.plan-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.plan-status.active {
  background: rgba(0, 123, 255, 0.1);
  color: #007bff;
}

.plan-status.completed {
  background: rgba(40, 167, 69, 0.1);
  color: #28a745;
}

.plan-status.overdue {
  background: rgba(220, 53, 69, 0.1);
  color: #dc3545;
}

/* 计划详情弹窗 */
.plan-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #7cc7f5;
  color: white;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.close-btn {
  font-size: 40rpx;
  font-weight: bold;
  padding: 10rpx;
}

.modal-body {
  max-height: 60vh;
  overflow-y: auto;
  padding: 30rpx;
}

.detail-section {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.resident-detail {
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.resident-detail text {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

/* 任务列表 */
.task-list {
  background: #f8f9fa;
  border-radius: 12rpx;
  overflow: hidden;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.completed {
  opacity: 0.6;
}

.task-item.completed .task-title {
  text-decoration: line-through;
}

.task-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #dee2e6;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  transition: all 0.3s ease;
}

.task-checkbox.checked {
  background: #28a745;
  border-color: #28a745;
  color: white;
}

.task-content {
  flex: 1;
}

.task-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.task-time {
  font-size: 24rpx;
  color: #999;
}

/* 护理记录 */
.nursing-notes {
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  min-height: 100rpx;
}

.nursing-notes text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-secondary {
  flex: 1;
  height: 80rpx;
  background: #6c757d;
  color: white;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-primary {
  flex: 1;
  height: 80rpx;
  background: #7cc7f5;
  color: white;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 创建计划按钮 */
.fab {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background: #7cc7f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(23, 162, 184, 0.3);
  z-index: 100;
}

.fab-icon {
  font-size: 60rpx;
  color: white;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 40rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
